Package: bcachefs-auto-snapshot
Architecture: any
Depends:
 bcachefs-tools,
 ${misc:Depends},
 ${shlibs:Depends}
Description: automatic snapshot tool for bcachefs subvolumes
 Creates read-only bcachefs snapshots on a systemd timer and prunes old
 snapshots according to configurable retention frequencies.
